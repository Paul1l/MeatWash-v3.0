{
  "name": "meat-auto-site",
  "version": "1.0.0",
  "private": true,
  "description": "Meat Auto Car Care Club: 12 страниц из реестра src/content/pages.mjs (scripts/content.mjs + pages.mjs), данные — dist/assets/meatwash-content.json и src/data/cars.json; 3D-гараж — блок /services по нажатию",
  "scripts": {
    "start": "node serve.cjs",
    "build": "node scripts/catalog.mjs && node scripts/content.mjs && node scripts/pages.mjs",
    "catalog": "node scripts/catalog.mjs",
    "content": "node scripts/content.mjs",
    "pages": "node scripts/pages.mjs",
    "check": "node scripts/check-scaffold.mjs",
    "check:release": "node scripts/check-scaffold.mjs --release",
    "check:legacy": "node scripts/check.mjs",
    "check:3d": "node scripts/check-3d.mjs",
    "check:page": "node scripts/check-scaffold.mjs",
    "img": "node scripts/img.mjs",
    "font": "sh scripts/font.sh",
    "preview-pack": "node scripts/preview-pack.mjs",
    "qa": "python3 scripts/qa/run.py",
    "optimize-3d": "node scripts/optimize-3d.mjs",
    "bundle-3d": "node scripts/bundle-3d.mjs",
    "hero-logo": "node scripts/hero-logo.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.4",
    "three": "^0.180.0"
  }
}
